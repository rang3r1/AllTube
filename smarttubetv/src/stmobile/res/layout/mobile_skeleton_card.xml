<?xml version="1.0" encoding="utf-8"?>
<!-- One placeholder video card: thumbnail, avatar, two text lines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_skeleton_thumb_height"
        android:background="@drawable/mobile_skeleton_block" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/mobile_skeleton_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/mobile_skeleton_block" />

            <View
                android:layout_width="160dp"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/mobile_skeleton_block" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
